# Database
DB_PASSWORD=your-mysql-password

# JWT (access token) - MUST be identical to api-gateway-service's JWT_SECRET,
# since the Gateway is what verifies access tokens on every request.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-shared-with-the-gateway
# JWT (refresh token) - only ever verified here in auth-service, never by
# the Gateway. Use a DIFFERENT secret from JWT_SECRET.
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ISSUER=banking-auth-service
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Refresh-token cookie. In production this MUST be secure=true (HTTPS) and
# same-site=None if the frontend is on a different origin, or same-site=Lax
# if it's on the same site. For local http dev, secure=false + Lax is fine.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# One-time bootstrap ROOT admin - created only if no ADMIN exists yet.
# Log in with this, create further admins via POST /api/v1/auth/admin/users
# (role: ADMIN) - they get identical privileges - then change this password.
ADMIN_BOOTSTRAP_EMAIL=admin@bank.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
